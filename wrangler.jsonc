{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym-tracker",
  "main": ".open-next/worker.js",
  // Must be >= the date OpenNext was built against; older dates change runtime
  // behaviour under you.
  "compatibility_date": "2026-08-01",
  // nodejs_compat is not optional here: Prisma's pg adapter opens a real TCP
  // socket to Postgres, and next/font, crypto and stream all need Node built-ins.
  "compatibility_flags": ["nodejs_compat"],

  // Only /gym* reaches this Worker; the rest of jackwebberley.com is untouched.
  "routes": [
    {
      "pattern": "jackwebberley.com/gym*",
      "zone_name": "jackwebberley.com"
    },
    {
      "pattern": "www.jackwebberley.com/gym*",
      "zone_name": "jackwebberley.com"
    }
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Hyperdrive pools Postgres connections at Cloudflare's edge and terminates TLS
  // to Supabase itself. Workers cannot do the TLS handshake pg expects over the
  // socket shim, and every isolate opening its own connection would exhaust
  // Supabase's limit anyway.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a4edfa75732c4b3cb1e12953b6dd6324"
    }
  ],

  "observability": {
    "enabled": true
  },

  // Secrets are NOT set here — they go in via `wrangler secret put`, which keeps
  // them out of the repo. See README → Deploying.
  //   DATABASE_URL
  //   DIRECT_URL
  //   ANTHROPIC_API_KEY
  //   ANTHROPIC_WORKSPACE_ID   (only for an identity-linked key)
  "vars": {}
}
