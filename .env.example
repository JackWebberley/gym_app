# ─────────────────────────────────────────────────────────────────────────────
# Supabase
#
# Dashboard → the green "Connect" button at the top → "Connection String".
# (Older UI: Project Settings → Database → Connection string.)
#
# You will see three options. Copy two of them:
#
#   Transaction pooler  :6543  → DATABASE_URL   (the app)
#   Session pooler      :5432  → DIRECT_URL     (migrations, seeding)
#   Direct connection   :5432  → DIRECT_URL, but only on an IPv6 network
#
# Use the Session pooler for DIRECT_URL unless you know your network does IPv6.
# Supabase's "Direct connection" (host db.[PROJECT-REF].supabase.co) is
# IPv6-only unless you have bought the IPv4 add-on, so on most home and CI
# networks it simply will not resolve. The Session pooler is also session-mode,
# so migrations work over it exactly the same.
#
# Replace [YOUR-PASSWORD] with the database password (Settings → Database →
# Database password → Reset if you no longer have it). If the password contains
# any of  : / ? # [ ] @  it must be percent-encoded.
# ─────────────────────────────────────────────────────────────────────────────

# Transaction pooler, port 6543. pgbouncer=true tells Prisma not to use prepared
# statements, which the transaction pooler cannot hold across statements.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&uselibpqcompat=true&sslmode=require"

# Session pooler, port 5432. DDL needs a real session, which the transaction
# pooler cannot provide.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require"

# Optional: per-instance connection pool size on top of Supavisor. Default 5.
# DATABASE_POOL_MAX=5

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic
#
# Needed only for chat macro estimation. Manual entry and the saved-food library
# work without it. https://console.anthropic.com/settings/keys
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Only needed if your key is identity-linked (the API will say so with a 400
# naming anthropic-workspace-id). Console -> Settings -> Workspaces; the id looks
# like wrkspc_01... A workspace-scoped key needs no value here.
ANTHROPIC_WORKSPACE_ID=""
